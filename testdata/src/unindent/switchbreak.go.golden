package unindent

func SwitchBreakLeavesSwitch(xs []int, mode int) int {
	n := 0

	for _, x := range xs {
		if x > 0 {
			switch mode {
			case 1:
				break
			default:
				break
			}
		} else {
			n++
		}

		n += x
	}

	return n
}

func SwitchContinueLeavesIf(xs []int, mode int) int {
	n := 0

	for _, x := range xs {
		if x > 0 {
			switch mode {
			case 1:
				continue
			default:
				continue
			}
		}

		// want `^Unnecessary "else": preceding conditions always end in a "return", "break", "continue" or a call that never returns. Remove the "else" wrapping the block of statements$`
		n++

		n += x
	}

	return n
}

func SwitchLabeledBreakLeavesIf(xs []int, mode int) int {
	n := 0

loop:
	for _, x := range xs {
		if x > 0 {
			switch mode {
			case 1:
				break loop
			default:
				break loop
			}
		}

		// want `^Unnecessary "else": preceding conditions always end in a "return", "break", "continue" or a call that never returns. Remove the "else" wrapping the block of statements$`
		n++

		n += x
	}

	return n
}

func SwitchNestedIfBreakLeavesSwitch(xs []int, mode int) int {
	n := 0

	for _, x := range xs {
		if x > 0 {
			switch mode {
			case 1:
				if x > 1 {
					break
				}

				// want `^Unnecessary "else": preceding conditions always end in a "return", "break", "continue" or a call that never returns. Remove the "else" wrapping the block of statements$`
				return n
			default:
				return n
			}
		} else {
			n++
		}

		n += x
	}

	return n
}

func BreakInCaseLeavesIf(x, mode int) int {
	n := 0

	switch mode {
	case 1:
		if x > 0 {
			break
		}

		// want `^Unnecessary "else": preceding conditions always end in a "return", "break", "continue" or a call that never returns. Remove the "else" wrapping the block of statements$`
		n++

		n += x
	}

	return n
}
